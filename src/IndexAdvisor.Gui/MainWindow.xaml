<Window x:Class="IndexAdvisor.Gui.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:views="clr-namespace:IndexAdvisor.Gui.Views"
		Title="IndexAdvisor — аналіз індексів SQL Server"
		Icon="/Assets/IndexAdvisor.ico"
		Width="1440"
		Height="920"
		MinWidth="1040"
		MinHeight="640"
		WindowStartupLocation="CenterScreen">
	<DockPanel>
		<Border DockPanel.Dock="Bottom"
				Padding="12,6"
				BorderThickness="0,1,0,0"
				BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
			<DockPanel>
				<!-- Чого бракує з залежностей модуля (перевірка під час запуску програми). -->
				<TextBlock DockPanel.Dock="Right" Text="{Binding Dependencies.Summary}" Margin="16,0,0,0" VerticalAlignment="Center"
						   Foreground="{DynamicResource StatusWarningBrush}" TextTrimming="CharacterEllipsis" MaxWidth="560"
						   ToolTip="Вкладка «Параметри» → «Залежності модуля»"
						   Visibility="{Binding Dependencies.HasProblems, Converter={StaticResource BoolToVisibility}}" />
				<Grid VerticalAlignment="Center">
					<TextBlock Text="{Binding ModuleText}" TextTrimming="CharacterEllipsis" Opacity="0.7" ToolTip="{Binding ModulePath}"
							   Visibility="{Binding ModuleMissing, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
					<TextBlock Text="{Binding ModuleText}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource StatusErrorBrush}" ToolTip="{Binding ModulePath}"
							   Visibility="{Binding ModuleMissing, Converter={StaticResource BoolToVisibility}}" />
				</Grid>
			</DockPanel>
		</Border>

		<TabControl SelectedIndex="{Binding SelectedTab}" Margin="10,6,10,0">
			<TabItem Header="Запуск">
				<views:RunView />
			</TabItem>
			<TabItem Header="Конфігурація">
				<views:ConfigView DataContext="{Binding Editor}" />
			</TabItem>
			<TabItem Header="Результати">
				<views:ResultsView DataContext="{Binding Results}" />
			</TabItem>
			<TabItem Header="Інструменти">
				<views:ToolsView DataContext="{Binding Tools}" />
			</TabItem>
			<TabItem Header="Параметри">
				<views:PreferencesView DataContext="{Binding Preferences}" />
			</TabItem>
		</TabControl>
	</DockPanel>
</Window>
