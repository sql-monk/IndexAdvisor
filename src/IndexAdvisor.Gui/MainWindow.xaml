<Window x:Class="IndexAdvisor.Gui.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:views="clr-namespace:IndexAdvisor.Gui.Views"
		Title="IndexAdvisor — аналіз індексів SQL Server"
		Width="1440"
		Height="920"
		MinWidth="1040"
		MinHeight="640"
		WindowStartupLocation="CenterScreen">
	<DockPanel>
		<Border DockPanel.Dock="Bottom"
				Padding="12,6"
				BorderThickness="0,1,0,0"
				BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
			<DockPanel>
				<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
					<Button Content="Інший модуль…" Command="{Binding BrowseModuleCommand}" Padding="10,3"
							ToolTip="Вказати шлях до IndexAdvisor.psd1" />
					<Button Content="Автопошук" Command="{Binding ResetModuleCommand}" Margin="6,0,0,0" Padding="10,3"
							ToolTip="Повернути автоматичний пошук модуля" />
				</StackPanel>
				<TextBlock Text="{Binding ModuleText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.7"
						   ToolTip="{Binding ModulePath}" />
			</DockPanel>
		</Border>

		<TabControl SelectedIndex="{Binding SelectedTab}" Margin="10,6,10,0">
			<TabItem Header="Запуск">
				<views:RunView />
			</TabItem>
			<TabItem Header="Конфігурація YAML">
				<views:ConfigView DataContext="{Binding Editor}" />
			</TabItem>
			<TabItem Header="Результати">
				<views:ResultsView DataContext="{Binding Results}" />
			</TabItem>
		</TabControl>
	</DockPanel>
</Window>
