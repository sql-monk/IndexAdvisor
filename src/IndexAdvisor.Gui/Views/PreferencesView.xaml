<UserControl x:Class="IndexAdvisor.Gui.Views.PreferencesView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:infra="clr-namespace:IndexAdvisor.Gui.Infrastructure">
	<!-- DataContext — PreferencesViewModel. Зміни застосовуються й зберігаються одразу. -->
	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="4,8,18,24" MaxWidth="900" HorizontalAlignment="Left">

			<TextBlock Style="{StaticResource SectionHeader}" Margin="0,4,0,2" Text="Вигляд" />
			<TextBlock Style="{StaticResource FieldLabel}"><Run Text="Тема" /><InlineUIContainer BaselineAlignment="Center"><infra:HelpButton Topic="Preferences:Theme" Title="Тема" /></InlineUIContainer></TextBlock>
			<ComboBox ItemsSource="{Binding ThemeChoices}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding Theme}"
					  Width="320" HorizontalAlignment="Left" AutomationProperties.Name="Тема" />
			<TextBlock Style="{StaticResource HintText}" Text="«Як у Windows» — світла або темна відповідно до теми застосунків Windows; змінюється разом із нею." />

			<TextBlock Style="{StaticResource FieldLabel}"><Run Text="Розмір шрифту журналу й редакторів" /><InlineUIContainer BaselineAlignment="Center"><infra:HelpButton Topic="Preferences:FontSize" Title="Розмір шрифту журналу й редакторів" /></InlineUIContainer></TextBlock>
			<ComboBox ItemsSource="{Binding FontSizes}" SelectedItem="{Binding FontSize}" Width="120" HorizontalAlignment="Left"
					  AutomationProperties.Name="Розмір шрифту" />
			<StackPanel Orientation="Horizontal" Margin="0,12,0,0">
				<CheckBox Content="Переносити довгі рядки журналу" IsChecked="{Binding LogWordWrap}" />
				<infra:HelpButton Topic="Preferences:LogWordWrap" Title="Перенос рядків журналу" />
			</StackPanel>
			<TextBlock Style="{StaticResource FieldLabel}"><Run Text="Максимум рядків журналу" /><InlineUIContainer BaselineAlignment="Center"><infra:HelpButton Topic="Preferences:MaxLogLinesText" Title="Максимум рядків журналу" /></InlineUIContainer></TextBlock>
			<TextBox Text="{Binding MaxLogLinesText, UpdateSourceTrigger=LostFocus}" Width="160" HorizontalAlignment="Left"
					 AutomationProperties.Name="Максимум рядків журналу" />
			<TextBlock Style="{StaticResource HintText}" Text="Від 1000 до 500000; старіші рядки відкидаються." />

			<TextBlock Style="{StaticResource SectionHeader}"><Run Text="Модуль IndexAdvisor і PowerShell" /><InlineUIContainer BaselineAlignment="Center"><infra:HelpButton Topic="Preferences:ModulePath" Title="Модуль IndexAdvisor" /></InlineUIContainer></TextBlock>
			<TextBlock Text="{Binding Main.ModuleSummary}" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold"
					   Visibility="{Binding Main.ModuleMissing, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
			<TextBlock Text="{Binding Main.ModuleSummary}" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold" Foreground="{DynamicResource StatusErrorBrush}"
					   Visibility="{Binding Main.ModuleMissing, Converter={StaticResource BoolToVisibility}}" />
			<TextBlock Text="{Binding Main.ModulePath}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Margin="0,4,0,0" />
			<TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
					   Text="Порядок: вибраний тут IndexAdvisor.psd1 (якщо його немає — помилка, інший модуль не підставляється) → у збірці для розробки src\IndexAdvisor репозиторію → Modules\IndexAdvisor у теці програми." />
			<StackPanel Orientation="Horizontal" Margin="0,8,0,0">
				<Button Content="Вибрати IndexAdvisor.psd1…" Command="{Binding Main.BrowseModuleCommand}" />
				<Button Content="Вбудований модуль" Command="{Binding Main.ResetModuleCommand}" Margin="8,0,0,0"
						ToolTip="Забути вибраний шлях: модуль з теки програми (у збірці для розробки — src\IndexAdvisor репозиторію)" />
				<Button Content="Відкрити теку модуля" Command="{Binding Main.OpenModuleFolderCommand}" Margin="8,0,0,0" />
			</StackPanel>
			<TextBlock TextWrapping="Wrap" Margin="0,12,0,0">
				<Run Text="{Binding Main.AppText, Mode=OneWay}" />
				<LineBreak />
				<Run Text="{Binding Main.PowerShellText, Mode=OneWay}" />
			</TextBlock>
			<StackPanel Orientation="Horizontal" Margin="0,8,0,0">
				<Button Content="Відкрити теку програми" Command="{Binding Main.OpenAppFolderCommand}" />
			</StackPanel>

			<TextBlock Style="{StaticResource FieldLabel}"><Run Text="Політика виконання вбудованого PowerShell (для процесу)" /><InlineUIContainer BaselineAlignment="Center"><infra:HelpButton Topic="Preferences:ExecutionPolicyName" Title="Політика виконання вбудованого PowerShell (для процесу)" /></InlineUIContainer></TextBlock>
			<ComboBox ItemsSource="{Binding PolicyChoices}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding ExecutionPolicyName}"
					  Width="560" HorizontalAlignment="Left" AutomationProperties.Name="Політика виконання" />
			<TextBlock Text="{Binding PolicyWarning}" Foreground="{DynamicResource StatusWarningBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
					   Visibility="{Binding PolicyWarning, Converter={StaticResource EmptyToVisible}, ConverterParameter=Invert}" />
			<TextBlock Style="{StaticResource HintText}" Text="Діє з наступної операції. Групова політика Windows має пріоритет." />

			<TextBlock Style="{StaticResource SectionHeader}"><Run Text="Залежності модуля" /><InlineUIContainer BaselineAlignment="Center"><infra:HelpButton Topic="Preferences:Dependencies" Title="Залежності модуля" /></InlineUIContainer></TextBlock>
			<TextBlock TextWrapping="Wrap" Margin="0,6,0,0">
				<Run Text="Тека залежностей IndexAdvisor:" /> <Run Text="{Binding Main.Dependencies.ModulesRoot, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
			</TextBlock>
			<TextBlock Text="{Binding Main.Dependencies.Summary}" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold"
					   Visibility="{Binding Main.Dependencies.HasProblems, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
			<TextBlock Text="{Binding Main.Dependencies.Summary}" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold" Foreground="{DynamicResource StatusWarningBrush}"
					   Visibility="{Binding Main.Dependencies.HasProblems, Converter={StaticResource BoolToVisibility}}" />
			<ItemsControl ItemsSource="{Binding Main.Dependencies.Items}" Margin="0,6,0,0" Focusable="False">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Grid Margin="0,3,0,3">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="290" />
								<ColumnDefinition Width="100" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<TextBlock Text="{Binding Name}" ToolTip="{Binding Purpose}" TextTrimming="CharacterEllipsis" />
							<TextBlock Grid.Column="1" Text="{Binding Version}" FontFamily="{StaticResource MonoFont}" />
							<TextBlock Grid.Column="2" Text="{Binding Location}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap"
									   Visibility="{Binding IsProblem, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
							<TextBlock Grid.Column="2" Text="{Binding Location}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap"
									   Foreground="{DynamicResource StatusWarningBrush}"
									   Visibility="{Binding IsProblem, Converter={StaticResource BoolToVisibility}}" />
						</Grid>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
			<TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
					   Text="Import-Module бере першу теку PSModulePath, у якій є модуль. Тека залежностей IndexAdvisor — завжди перша; далі — профіль PowerShell і системні теки:" />
			<ItemsControl ItemsSource="{Binding Main.Dependencies.SearchOrder}" Margin="12,4,0,0" Focusable="False">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Opacity="0.8" TextWrapping="Wrap" />
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
			<StackPanel Orientation="Horizontal" Margin="0,8,0,0">
				<Button Content="Встановити з PowerShell Gallery…" Command="{Binding Main.Dependencies.InstallCommand}"
						ToolTip="Найновіші версії всіх залежностей у теку залежностей IndexAdvisor" />
				<Button Content="Перевірити" Command="{Binding Main.Dependencies.RefreshCommand}" Margin="8,0,0,0" />
				<Button Content="Відкрити теку" Command="{Binding Main.Dependencies.OpenFolderCommand}" Margin="8,0,0,0" />
				<Button Content="Копіювати команду Save-Module" Command="{Binding Main.Dependencies.CopyCommandCommand}" Margin="8,0,0,0"
						ToolTip="{Binding Main.Dependencies.SaveModuleCommand}" />
			</StackPanel>
			<TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
					   Text="Без доступу до PowerShell Gallery — та сама команда в PowerShell, за потреби з -Repository внутрішнього репозиторію." />

			<TextBlock Style="{StaticResource SectionHeader}" Text="Поведінка" />
			<StackPanel Orientation="Horizontal" Margin="0,8,0,0">
				<CheckBox Content="Перевіряти конфігурацію (Test-IaConfig) одразу після вибору файлу" IsChecked="{Binding AutoValidateConfig}" />
				<infra:HelpButton Topic="Preferences:AutoValidateConfig" Title="Автоперевірка конфігурації" />
			</StackPanel>
			<StackPanel Orientation="Horizontal" Margin="0,8,0,0">
				<CheckBox Content="Відкривати редактор конфігурації на формі налаштувань (інакше — на тексті YAML)" IsChecked="{Binding ConfigFormFirst}" />
				<infra:HelpButton Topic="Preferences:ConfigFormFirst" Title="Форма налаштувань першою" />
			</StackPanel>
			<StackPanel Orientation="Horizontal" Margin="0,8,0,0">
				<CheckBox Content="Блимати кнопкою на панелі завдань, коли модуль чекає на відповідь" IsChecked="{Binding FlashOnPrompt}" />
				<infra:HelpButton Topic="Preferences:FlashOnPrompt" Title="Блимання на панелі завдань" />
			</StackPanel>
			<StackPanel Orientation="Horizontal" Margin="0,8,0,0">
				<CheckBox Content="Звуковий сигнал після завершення аналізу" IsChecked="{Binding SoundOnFinish}" />
				<infra:HelpButton Topic="Preferences:SoundOnFinish" Title="Звуковий сигнал" />
			</StackPanel>
			<StackPanel Orientation="Horizontal" Margin="0,8,0,0">
				<CheckBox Content="Переходити на вкладку «Результати» після запуску" IsChecked="{Binding OpenResultsAfterRun}" />
				<infra:HelpButton Topic="Preferences:OpenResultsAfterRun" Title="Перехід до результатів" />
			</StackPanel>
			<TextBlock Style="{StaticResource FieldLabel}"><Run Text="Глибина пошуку result.json у каталозі результатів" /><InlineUIContainer BaselineAlignment="Center"><infra:HelpButton Topic="Preferences:ResultsScanDepthText" Title="Глибина пошуку result.json у каталозі результатів" /></InlineUIContainer></TextBlock>
			<TextBox Text="{Binding ResultsScanDepthText, UpdateSourceTrigger=LostFocus}" Width="120" HorizontalAlignment="Left"
					 AutomationProperties.Name="Глибина пошуку" />
			<TextBlock Style="{StaticResource HintText}" Text="0 — лише вибрана тека; 1 — out\запуск; 3 — прогін\out\запуск. Максимум 8." />

			<TextBlock Style="{StaticResource SectionHeader}"><Run Text="Шаблони конфігурацій" /><InlineUIContainer BaselineAlignment="Center"><infra:HelpButton Topic="Preferences:TemplatesFolder" Title="Тека шаблонів" /></InlineUIContainer></TextBlock>
			<TextBlock TextWrapping="Wrap" Margin="0,6,0,0">
				<Run Text="Тека:" /> <Run Text="{Binding TemplatesFolder, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
			</TextBlock>
			<TextBlock Style="{StaticResource HintText}" Text="Звичайні YAML-файли. Можна вказати спільну теку команди, щоб усі створювали конфігурації з однакових шаблонів." />
			<StackPanel Orientation="Horizontal" Margin="0,8,0,0">
				<Button Content="Вибрати теку…" Command="{Binding BrowseTemplatesFolderCommand}" />
				<Button Content="Типова" Command="{Binding ResetTemplatesFolderCommand}" Margin="8,0,0,0" />
				<Button Content="Відкрити" Command="{Binding OpenTemplatesFolderCommand}" Margin="8,0,0,0" />
			</StackPanel>

			<TextBlock Style="{StaticResource SectionHeader}"><Run Text="Налаштування програми" /><InlineUIContainer BaselineAlignment="Center"><infra:HelpButton Topic="Preferences:SettingsFilePath" Title="Файл налаштувань програми" /></InlineUIContainer></TextBlock>
			<TextBlock TextWrapping="Wrap" Margin="0,6,0,0">
				<Run Text="Файл:" /> <Run Text="{Binding SettingsFilePath, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
			</TextBlock>
			<TextBlock Style="{StaticResource HintText}" Text="Секретів і небезпечних режимів у файлі немає: лише шляхи, імена серверів, параметри форми й ці налаштування." />
			<StackPanel Orientation="Horizontal" Margin="0,8,0,0">
				<Button Content="Відкрити теку" Command="{Binding OpenSettingsFolderCommand}" />
				<Button Content="Скинути форму запуску" Command="{Binding ResetRunFormCommand}" Margin="8,0,0,0"
						ToolTip="Очистити всі перевизначення на вкладці «Запуск», крім файлу конфігурації" />
			</StackPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
