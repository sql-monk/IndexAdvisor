<UserControl x:Class="IndexAdvisor.Gui.Views.PreferencesView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!-- DataContext — PreferencesViewModel. Зміни застосовуються й зберігаються одразу. -->
	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="4,8,18,24" MaxWidth="900" HorizontalAlignment="Left">

			<TextBlock Style="{StaticResource SectionHeader}" Margin="0,4,0,2" Text="Вигляд" />
			<TextBlock Style="{StaticResource FieldLabel}" Text="Тема" />
			<ComboBox ItemsSource="{Binding ThemeChoices}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding Theme}"
					  Width="320" HorizontalAlignment="Left" AutomationProperties.Name="Тема" />
			<TextBlock Style="{StaticResource HintText}" Text="«Як у Windows» — світла або темна відповідно до теми застосунків Windows; змінюється разом із нею." />

			<TextBlock Style="{StaticResource FieldLabel}" Text="Розмір шрифту журналу й редакторів" />
			<ComboBox ItemsSource="{Binding FontSizes}" SelectedItem="{Binding FontSize}" Width="120" HorizontalAlignment="Left"
					  AutomationProperties.Name="Розмір шрифту" />
			<CheckBox Content="Переносити довгі рядки журналу" IsChecked="{Binding LogWordWrap}" Margin="0,12,0,0" />
			<TextBlock Style="{StaticResource FieldLabel}" Text="Максимум рядків журналу" />
			<TextBox Text="{Binding MaxLogLinesText, UpdateSourceTrigger=LostFocus}" Width="160" HorizontalAlignment="Left"
					 AutomationProperties.Name="Максимум рядків журналу" />
			<TextBlock Style="{StaticResource HintText}" Text="Від 1000 до 500000; старіші рядки відкидаються." />

			<TextBlock Style="{StaticResource SectionHeader}" Text="Модуль IndexAdvisor і PowerShell" />
			<TextBlock Text="{Binding Main.ModuleText}" TextWrapping="Wrap" Margin="0,6,0,0" />
			<StackPanel Orientation="Horizontal" Margin="0,8,0,0">
				<Button Content="Вибрати IndexAdvisor.psd1…" Command="{Binding Main.BrowseModuleCommand}" />
				<Button Content="Автопошук" Command="{Binding Main.ResetModuleCommand}" Margin="8,0,0,0"
						ToolTip="src\IndexAdvisor у репозиторії над програмою → Modules\IndexAdvisor поруч з exe → PSModulePath" />
			</StackPanel>

			<TextBlock Style="{StaticResource FieldLabel}" Text="Політика виконання вбудованого PowerShell (для процесу)" />
			<ComboBox ItemsSource="{Binding PolicyChoices}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding ExecutionPolicyName}"
					  Width="560" HorizontalAlignment="Left" AutomationProperties.Name="Політика виконання" />
			<TextBlock Text="{Binding PolicyWarning}" Foreground="{DynamicResource StatusWarningBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
					   Visibility="{Binding PolicyWarning, Converter={StaticResource EmptyToVisible}, ConverterParameter=Invert}" />
			<TextBlock Style="{StaticResource HintText}" Text="Діє з наступної операції. Групова політика Windows має пріоритет." />

			<TextBlock Style="{StaticResource SectionHeader}" Text="Поведінка" />
			<CheckBox Content="Перевіряти конфігурацію (Test-IaConfig) одразу після вибору файлу" IsChecked="{Binding AutoValidateConfig}" Margin="0,8,0,0" />
			<CheckBox Content="Відкривати редактор конфігурації на формі налаштувань (інакше — на тексті YAML)" IsChecked="{Binding ConfigFormFirst}" Margin="0,8,0,0" />
			<CheckBox Content="Блимати кнопкою на панелі завдань, коли модуль чекає на відповідь" IsChecked="{Binding FlashOnPrompt}" Margin="0,8,0,0" />
			<CheckBox Content="Звуковий сигнал після завершення аналізу" IsChecked="{Binding SoundOnFinish}" Margin="0,8,0,0" />
			<CheckBox Content="Переходити на вкладку «Результати» після запуску" IsChecked="{Binding OpenResultsAfterRun}" Margin="0,8,0,0" />
			<TextBlock Style="{StaticResource FieldLabel}" Text="Глибина пошуку result.json у каталозі результатів" />
			<TextBox Text="{Binding ResultsScanDepthText, UpdateSourceTrigger=LostFocus}" Width="120" HorizontalAlignment="Left"
					 AutomationProperties.Name="Глибина пошуку" />
			<TextBlock Style="{StaticResource HintText}" Text="0 — лише вибрана тека; 1 — out\запуск; 3 — прогін\out\запуск. Максимум 8." />

			<TextBlock Style="{StaticResource SectionHeader}" Text="Шаблони конфігурацій" />
			<TextBlock TextWrapping="Wrap" Margin="0,6,0,0">
				<Run Text="Тека:" /> <Run Text="{Binding TemplatesFolder, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
			</TextBlock>
			<TextBlock Style="{StaticResource HintText}" Text="Звичайні YAML-файли. Можна вказати спільну теку команди, щоб усі створювали конфігурації з однакових шаблонів." />
			<StackPanel Orientation="Horizontal" Margin="0,8,0,0">
				<Button Content="Вибрати теку…" Command="{Binding BrowseTemplatesFolderCommand}" />
				<Button Content="Типова" Command="{Binding ResetTemplatesFolderCommand}" Margin="8,0,0,0" />
				<Button Content="Відкрити" Command="{Binding OpenTemplatesFolderCommand}" Margin="8,0,0,0" />
			</StackPanel>

			<TextBlock Style="{StaticResource SectionHeader}" Text="Налаштування програми" />
			<TextBlock TextWrapping="Wrap" Margin="0,6,0,0">
				<Run Text="Файл:" /> <Run Text="{Binding SettingsFilePath, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
			</TextBlock>
			<TextBlock Style="{StaticResource HintText}" Text="Секретів і небезпечних режимів у файлі немає: лише шляхи, імена серверів, параметри форми й ці налаштування." />
			<StackPanel Orientation="Horizontal" Margin="0,8,0,0">
				<Button Content="Відкрити теку" Command="{Binding OpenSettingsFolderCommand}" />
				<Button Content="Скинути форму запуску" Command="{Binding ResetRunFormCommand}" Margin="8,0,0,0"
						ToolTip="Очистити всі перевизначення на вкладці «Запуск», крім файлу конфігурації" />
			</StackPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
