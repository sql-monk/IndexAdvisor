<UserControl x:Class="IndexAdvisor.Gui.Views.ResultsView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="clr-namespace:IndexAdvisor.Gui.ViewModels"
			 xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
			 xmlns:infra="clr-namespace:IndexAdvisor.Gui.Infrastructure">
	<UserControl.Resources>

		<Style x:Key="ScriptEditor" TargetType="avalonEdit:TextEditor">
			<Setter Property="IsReadOnly" Value="True" />
			<Setter Property="ShowLineNumbers" Value="True" />
			<Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
			<Setter Property="infra:EditorTheming.Highlighting" Value="TSQL" />
			<Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
			<Setter Property="VerticalScrollBarVisibility" Value="Auto" />
			<Setter Property="Padding" Value="4" />
		</Style>

		<!-- Текст клітинки по центру рядка, як у шаблонних колонках. -->
		<Style x:Key="CellText" TargetType="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="TextTrimming" Value="CharacterEllipsis" />
		</Style>

		<Style x:Key="DetailLabel" TargetType="TextBlock">
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Margin" Value="0,12,0,3" />
		</Style>

		<Style x:Key="ResultsGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
			<Setter Property="AutoGenerateColumns" Value="False" />
			<Setter Property="IsReadOnly" Value="True" />
			<Setter Property="HeadersVisibility" Value="Column" />
			<Setter Property="GridLinesVisibility" Value="Horizontal" />
			<Setter Property="SelectionMode" Value="Single" />
			<Setter Property="CanUserReorderColumns" Value="True" />
			<Setter Property="CanUserResizeColumns" Value="True" />
			<Setter Property="CanUserSortColumns" Value="True" />
			<Setter Property="EnableRowVirtualization" Value="True" />
		</Style>

		<!-- Подробиці запуску. -->
		<DataTemplate DataType="{x:Type vm:RunDetailsViewModel}">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<Border Style="{StaticResource Card}">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel>
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="{Binding Server}" FontSize="20" FontWeight="SemiBold" />
								<Border Style="{StaticResource Badge}" Margin="12,2,0,0"
										Background="{Binding Status, Converter={StaticResource StatusBrush}}">
									<TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource BadgeForegroundBrush}" FontSize="12" />
								</Border>
							</StackPanel>
							<TextBlock Margin="0,4,0,0" Opacity="0.75" TextWrapping="Wrap">
								<Run Text="{Binding ModuleText, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding TimeText, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding TopologyText, Mode=OneWay}" />
							</TextBlock>
							<Grid Margin="0,10,0,0">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition />
									<RowDefinition />
									<RowDefinition />
									<RowDefinition />
									<RowDefinition />
								</Grid.RowDefinitions>
								<TextBlock Text="Період даних" Opacity="0.7" Margin="0,1,16,1" />
								<TextBlock Grid.Column="1" Text="{Binding PeriodText}" TextWrapping="Wrap" Margin="0,1">
									<TextBlock.Style>
										<Style TargetType="TextBlock">
											<Style.Triggers>
												<DataTrigger Binding="{Binding PeriodInsufficient}" Value="True">
													<Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
													<Setter Property="FontWeight" Value="SemiBold" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>
								<TextBlock Grid.Row="1" Text="Вікно аналізу" Opacity="0.7" Margin="0,1,16,1" />
								<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AnalysisWindowText}" Margin="0,1" />
								<TextBlock Grid.Row="2" Text="Модель" Opacity="0.7" Margin="0,1,16,1" />
								<TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LlmText}" TextWrapping="Wrap" Margin="0,1" />
								<TextBlock Grid.Row="3" Text="Безпека" Opacity="0.7" Margin="0,1,16,1" />
								<TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MaskingText}" TextWrapping="Wrap" Margin="0,1" />
								<TextBlock Grid.Row="4" Text="Набори даних" Opacity="0.7" Margin="0,1,16,1" />
								<TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DatasetsText}" TextWrapping="Wrap" Margin="0,1" />
							</Grid>
							<TextBlock Text="{Binding UnsafeText}" Foreground="{DynamicResource StatusErrorBrush}" FontWeight="SemiBold" Margin="0,6,0,0"
									   Visibility="{Binding UnsafeText, Converter={StaticResource EmptyToVisible}, ConverterParameter=Invert}" />
						</StackPanel>
						<StackPanel Grid.Column="1" Margin="16,0,0,0" MinWidth="170">
							<ItemsControl ItemsSource="{Binding Files}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Button Content="{Binding Label}" Margin="0,0,0,6" HorizontalAlignment="Stretch" ToolTip="{Binding Path}"
												Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
												CommandParameter="{Binding}" />
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							<Button Content="Копіювати підсумок" Command="{Binding CopySummaryCommand}" HorizontalAlignment="Stretch" />
						</StackPanel>
					</Grid>
				</Border>

				<TabControl Grid.Row="1" Margin="0,10,0,0">

					<!-- Рекомендації. -->
					<TabItem Header="{Binding RecommendationsHeader}">
						<Grid Margin="0,8,0,0">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" MinHeight="120" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="1.25*" MinHeight="160" />
							</Grid.RowDefinitions>
							<DockPanel>
								<TextBlock DockPanel.Dock="Right" Text="{Binding RecommendationsSummary}" Opacity="0.7" VerticalAlignment="Center" Margin="12,0,0,0" />
								<StackPanel Orientation="Horizontal">
									<Grid Width="260">
										<TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
										<TextBlock Style="{StaticResource Watermark}" Text="Пошук: таблиця, індекс, текст…"
												   Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisible}}" />
									</Grid>
									<ComboBox ItemsSource="{Binding ActionChoices}" SelectedItem="{Binding ActionFilter}" DisplayMemberPath="Display"
											  Width="190" Margin="8,0,0,0" />
									<ComboBox ItemsSource="{Binding ValidationChoices}" SelectedItem="{Binding ValidationFilter}" DisplayMemberPath="Display"
											  Width="190" Margin="8,0,0,0" />
									<CheckBox Content="Сховати відхилені перевіркою" IsChecked="{Binding HideRejected}" Margin="12,0,0,0" VerticalAlignment="Center" />
								</StackPanel>
							</DockPanel>

							<DataGrid Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource ResultsGrid}"
									  ItemsSource="{Binding RecommendationsView}"
									  SelectedItem="{Binding SelectedRecommendation}">
								<DataGrid.Columns>
									<DataGridTextColumn Header="№" Binding="{Binding Number}" Width="50" ElementStyle="{StaticResource CellText}" />
									<DataGridTextColumn Header="Дія" Binding="{Binding ActionText}" Width="150" ElementStyle="{StaticResource CellText}" />
									<DataGridTextColumn Header="База" Binding="{Binding DatabaseText}" Width="120" ElementStyle="{StaticResource CellText}" />
									<DataGridTextColumn Header="Таблиця" Binding="{Binding TableText}" Width="2*" ElementStyle="{StaticResource CellText}" />
									<DataGridTextColumn Header="Індекс" Binding="{Binding IndexText}" Width="1.5*" ElementStyle="{StaticResource CellText}" />
									<DataGridTemplateColumn Header="Ризик" Width="95" SortMemberPath="Risk">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBlock Text="{Binding RiskText}" Foreground="{Binding Risk, Converter={StaticResource StatusBrush}}" FontWeight="SemiBold" VerticalAlignment="Center" />
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
									<DataGridTextColumn Header="Впевненість" Binding="{Binding ConfidenceText}" Width="105" ElementStyle="{StaticResource CellText}" />
									<DataGridTemplateColumn Header="Перевірка" Width="125" SortMemberPath="Validation">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBlock Text="{Binding ValidationText}" Foreground="{Binding Validation, Converter={StaticResource StatusBrush}}" FontWeight="SemiBold" VerticalAlignment="Center" />
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
									<DataGridTextColumn Header="Джерело" Binding="{Binding SourceText}" Width="85" ElementStyle="{StaticResource CellText}" />
								</DataGrid.Columns>
							</DataGrid>

							<GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="Transparent" />

							<Grid Grid.Row="3" DataContext="{Binding SelectedRecommendation}"
								  Visibility="{Binding Converter={StaticResource EmptyToVisible}, ConverterParameter=Invert}">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" MinWidth="300" />
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="1.2*" MinWidth="320" />
								</Grid.ColumnDefinitions>

								<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
									<StackPanel>
										<TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
										<TextBlock Margin="0,4,0,0" Opacity="0.75" TextWrapping="Wrap">
											<Run Text="{Binding ActionText, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding ModuleText, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding ServerText, Mode=OneWay}" /> <Run Text="·" /> <Run Text="джерело:" /> <Run Text="{Binding SourceText, Mode=OneWay}" />
										</TextBlock>

										<TextBlock Style="{StaticResource DetailLabel}" Text="Обґрунтування" />
										<TextBlock Text="{Binding Rationale}" TextWrapping="Wrap" />

										<TextBlock Style="{StaticResource DetailLabel}">
											<Run Text="Ризик:" /> <Run Text="{Binding RiskText, Mode=OneWay}" Foreground="{Binding Risk, Converter={StaticResource StatusBrush}}" />
											<Run Text="   Впевненість:" /> <Run Text="{Binding ConfidenceText, Mode=OneWay}" />
										</TextBlock>
										<TextBlock Text="{Binding RiskDescription}" TextWrapping="Wrap" />

										<StackPanel Visibility="{Binding ImpactText, Converter={StaticResource EmptyToVisible}, ConverterParameter=Invert}">
											<TextBlock Style="{StaticResource DetailLabel}" Text="Вплив" />
											<TextBlock Text="{Binding ImpactText}" TextWrapping="Wrap" />
										</StackPanel>
										<StackPanel Visibility="{Binding ReplacesText, Converter={StaticResource EmptyToVisible}, ConverterParameter=Invert}">
											<TextBlock Style="{StaticResource DetailLabel}" Text="Замінює індекси" />
											<TextBlock Text="{Binding ReplacesText}" TextWrapping="Wrap" />
										</StackPanel>
										<StackPanel Visibility="{Binding DataPeriodText, Converter={StaticResource EmptyToVisible}, ConverterParameter=Invert}">
											<TextBlock Style="{StaticResource DetailLabel}" Text="Період даних" />
											<TextBlock Text="{Binding DataPeriodText}" TextWrapping="Wrap">
												<TextBlock.Style>
													<Style TargetType="TextBlock">
														<Style.Triggers>
															<DataTrigger Binding="{Binding PeriodInsufficient}" Value="True">
																<Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</TextBlock.Style>
											</TextBlock>
										</StackPanel>
										<StackPanel Visibility="{Binding CrossCheckText, Converter={StaticResource EmptyToVisible}, ConverterParameter=Invert}">
											<TextBlock Style="{StaticResource DetailLabel}" Text="Перехресна перевірка" />
											<TextBlock Text="{Binding CrossCheckText}" TextWrapping="Wrap" />
										</StackPanel>

										<StackPanel Visibility="{Binding HasDropEligibility, Converter={StaticResource BoolToVisibility}}">
											<TextBlock Style="{StaticResource DetailLabel}" Text="Умови видалення (розділ 4.4)" />
											<TextBlock Text="{Binding DropSummary}" TextWrapping="Wrap" Margin="0,0,0,4" />
											<ItemsControl ItemsSource="{Binding Conditions}">
												<ItemsControl.ItemTemplate>
													<DataTemplate>
														<Grid Margin="0,2,0,0">
															<Grid.ColumnDefinitions>
																<ColumnDefinition Width="22" />
																<ColumnDefinition Width="*" />
															</Grid.ColumnDefinitions>
															<TextBlock Text="{Binding Glyph}" FontWeight="Bold" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
															<TextBlock Grid.Column="1" TextWrapping="Wrap">
																<Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Details, Mode=OneWay}" />
															</TextBlock>
														</Grid>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</StackPanel>

										<StackPanel Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
											<TextBlock Style="{StaticResource DetailLabel}" Text="Попередження" Foreground="{DynamicResource StatusWarningBrush}" />
											<ItemsControl ItemsSource="{Binding Warnings}">
												<ItemsControl.ItemTemplate>
													<DataTemplate>
														<TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Margin="0,1,0,0" />
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</StackPanel>

										<TextBlock Style="{StaticResource DetailLabel}">
											<Run Text="Автоматична перевірка:" /> <Run Text="{Binding ValidationText, Mode=OneWay}" Foreground="{Binding Validation, Converter={StaticResource StatusBrush}}" />
										</TextBlock>
										<ItemsControl ItemsSource="{Binding Checks}">
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<Grid Margin="0,2,0,0">
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="110" />
															<ColumnDefinition Width="*" />
														</Grid.ColumnDefinitions>
														<TextBlock Text="{Binding StatusText}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" FontWeight="SemiBold" />
														<TextBlock Grid.Column="1" TextWrapping="Wrap">
															<Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Message, Mode=OneWay}" />
														</TextBlock>
													</Grid>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</StackPanel>
								</ScrollViewer>

								<GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

								<DockPanel Grid.Column="2">
									<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
										<Button Content="Копіювати виконання"
												Command="{Binding DataContext.CopyScriptCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
												CommandParameter="{Binding ExecuteScript}" />
										<Button Content="Копіювати відкат" Margin="6,0,0,0"
												Command="{Binding DataContext.CopyScriptCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
												CommandParameter="{Binding RollbackScript}" />
										<Button Content="Зберегти обидва…" Margin="6,0,0,0"
												Command="{Binding DataContext.SaveScriptsCommand, RelativeSource={RelativeSource AncestorType=TabControl}}" />
									</StackPanel>
									<TabControl>
										<TabItem Header="Скрипт виконання">
											<Border BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,6,0,0">
												<avalonEdit:TextEditor Style="{StaticResource ScriptEditor}" Document="{Binding ExecuteDocument}" />
											</Border>
										</TabItem>
										<TabItem Header="Скрипт відкату">
											<Border BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,6,0,0">
												<avalonEdit:TextEditor Style="{StaticResource ScriptEditor}" Document="{Binding RollbackDocument}" />
											</Border>
										</TabItem>
										<TabItem Header="Партиціонування" Visibility="{Binding HasPartitioning, Converter={StaticResource BoolToVisibility}}">
											<Border BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,6,0,0">
												<avalonEdit:TextEditor Style="{StaticResource ScriptEditor}" infra:EditorTheming.Highlighting="JavaScript" WordWrap="True"
																	   Document="{Binding PartitioningDocument}" />
											</Border>
										</TabItem>
									</TabControl>
								</DockPanel>
							</Grid>
						</Grid>
					</TabItem>

					<!-- Знахідки правил. -->
					<TabItem Header="{Binding FindingsHeader}">
						<DockPanel Margin="0,8,0,0">
							<Grid DockPanel.Dock="Top" Width="320" HorizontalAlignment="Left" Margin="0,0,0,8">
								<TextBox Text="{Binding FindingSearch, UpdateSourceTrigger=PropertyChanged}" />
								<TextBlock Style="{StaticResource Watermark}" Text="Пошук: правило, таблиця, індекс…"
										   Visibility="{Binding FindingSearch, Converter={StaticResource EmptyToVisible}}" />
							</Grid>
							<DataGrid Style="{StaticResource ResultsGrid}" ItemsSource="{Binding FindingsView}">
								<DataGrid.Columns>
									<DataGridTextColumn Header="Правило" Binding="{Binding RuleId}" Width="190" ElementStyle="{StaticResource CellText}" />
									<DataGridTemplateColumn Header="Важливість" Width="105" SortMemberPath="Severity">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBlock Text="{Binding SeverityText}" Foreground="{Binding Severity, Converter={StaticResource StatusBrush}}" FontWeight="SemiBold" VerticalAlignment="Center" />
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
									<DataGridTextColumn Header="База" Binding="{Binding Database}" Width="130" ElementStyle="{StaticResource CellText}" />
									<DataGridTextColumn Header="Таблиця" Binding="{Binding Table}" Width="220" ElementStyle="{StaticResource CellText}" />
									<DataGridTextColumn Header="Індекс" Binding="{Binding Index}" Width="200" ElementStyle="{StaticResource CellText}" />
									<DataGridTextColumn Header="Пропозиція" Binding="{Binding SuggestedAction}" Width="140" ElementStyle="{StaticResource CellText}" />
									<DataGridTemplateColumn Header="Повідомлення" Width="*">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2" />
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
								</DataGrid.Columns>
							</DataGrid>
						</DockPanel>
					</TabItem>

					<!-- Попередження й помилки запуску. -->
					<TabItem Header="{Binding MessagesHeader}">
						<ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
							<StackPanel>
								<TextBlock Text="Попереджень і помилок немає." Opacity="0.6" Margin="0,8"
										   Visibility="{Binding Messages.Count, Converter={StaticResource EmptyToVisible}}" />
								<ItemsControl ItemsSource="{Binding Messages}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border BorderThickness="4,0,0,0" BorderBrush="{Binding Severity, Converter={StaticResource StatusBrush}}"
													Padding="10,4" Margin="0,0,0,8">
												<StackPanel>
													<TextBlock Text="{Binding Source}" FontWeight="SemiBold" Opacity="0.8" />
													<TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2,0,0" />
												</StackPanel>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</ScrollViewer>
					</TabItem>

					<!-- Нотатки моделі. -->
					<TabItem Header="{Binding NotesHeader}">
						<ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
							<ItemsControl ItemsSource="{Binding Notes}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Style="{StaticResource Card}" Margin="0,0,0,10">
											<StackPanel>
												<TextBlock Text="{Binding Module}" FontWeight="SemiBold" />
												<TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,6,0,0" />
											</StackPanel>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</TabItem>

					<!-- Дозапити моделі. -->
					<TabItem Header="{Binding ToolRequestsHeader}">
						<DataGrid Style="{StaticResource ResultsGrid}" ItemsSource="{Binding ToolRequests}" Margin="0,8,0,0">
							<DataGrid.Columns>
								<DataGridTextColumn Header="Інструмент" Binding="{Binding Tool}" Width="190" ElementStyle="{StaticResource CellText}" />
								<DataGridTextColumn Header="Сервер / база" Binding="{Binding Target}" Width="200" ElementStyle="{StaticResource CellText}" />
								<DataGridTemplateColumn Header="Рішення" Width="140" SortMemberPath="Decision">
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<TextBlock Text="{Binding DecisionText}" Foreground="{Binding Decision, Converter={StaticResource StatusBrush}}" FontWeight="SemiBold" VerticalAlignment="Center" />
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>
								<DataGridTextColumn Header="Результат" Binding="{Binding ResponseText}" Width="200" ElementStyle="{StaticResource CellText}" />
								<DataGridTextColumn Header="Час" Binding="{Binding Executed}" Width="130" ElementStyle="{StaticResource CellText}" />
								<DataGridTemplateColumn Header="Причина запиту / рішення" Width="*">
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<StackPanel Margin="0,2">
												<TextBlock Text="{Binding Reason}" TextWrapping="Wrap" />
												<TextBlock Text="{Binding DecisionReason}" TextWrapping="Wrap" Opacity="0.7" />
											</StackPanel>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>
							</DataGrid.Columns>
						</DataGrid>
					</TabItem>
				</TabControl>
			</Grid>
		</DataTemplate>
	</UserControl.Resources>

	<Grid Margin="0,8,0,8">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="330" MinWidth="240" />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<DockPanel Margin="0,0,10,0">
			<StackPanel DockPanel.Dock="Top">
				<TextBlock Text="Каталог результатів" FontWeight="SemiBold" Margin="0,4,0,4" />
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<TextBox Text="{Binding Root, UpdateSourceTrigger=LostFocus}" ToolTip="{Binding Root}" />
					<Button Grid.Column="1" Content="…" Width="40" Margin="6,0,0,0" Command="{Binding BrowseRootCommand}" />
				</Grid>
				<WrapPanel Margin="0,8,0,0">
					<Button Content="Оновити" Command="{Binding RefreshCommand}" Margin="0,0,6,6" />
					<Button Content="Відкрити result.json…" Command="{Binding OpenFileCommand}" Margin="0,0,6,6" />
					<Button Content="Тека" Command="{Binding OpenRootCommand}" Margin="0,0,6,6" />
				</WrapPanel>
				<ProgressBar IsIndeterminate="True" Height="3" Margin="0,2,0,4"
							 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
				<TextBlock Text="{Binding StatusText}" Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,8" />
			</StackPanel>
			<ListBox ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Grid Margin="0,4">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="5" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Border CornerRadius="2" Background="{Binding Status, Converter={StaticResource StatusBrush}}" />
							<StackPanel Grid.Column="1" Margin="10,0,0,0">
								<TextBlock Text="{Binding Server}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
								<TextBlock Opacity="0.75" FontSize="12" TextTrimming="CharacterEllipsis">
									<Run Text="{Binding StartedText, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding StatusText, Mode=OneWay}" />
								</TextBlock>
								<TextBlock Text="{Binding DetailsText}" Opacity="0.75" FontSize="12" TextTrimming="CharacterEllipsis" />
							</StackPanel>
						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</DockPanel>

		<GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

		<Grid Grid.Column="2" Margin="6,0,0,0">
			<ContentControl Content="{Binding Details}" />
			<TextBlock Text="Виберіть запуск зліва або виконайте аналіз на вкладці «Запуск»."
					   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55"
					   Visibility="{Binding Details, Converter={StaticResource EmptyToVisible}}" />
		</Grid>
	</Grid>
</UserControl>
