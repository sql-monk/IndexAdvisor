<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<RootNamespace>IndexAdvisor.Gui</RootNamespace>
		<AssemblyName>IndexAdvisor.Gui</AssemblyName>
		<Version>0.2.0</Version>
		<Product>IndexAdvisor</Product>
		<Description>Графічна оболонка IndexAdvisor: запуск аналізу, підтвердження дозапитів моделі, перегляд рекомендацій.</Description>
		<!-- ThemeMode (Fluent) у WPF позначено як експериментальний. -->
		<NoWarn>$(NoWarn);WPF0001</NoWarn>
		<!-- Іконка exe (Провідник, панель завдань); вікна беруть її як ресурс. Малює Assets\New-AppIcon.ps1. -->
		<ApplicationIcon>Assets\IndexAdvisor.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<!-- Версія SDK відповідає PowerShell 7.6 (.NET 10). -->
		<PackageReference Include="Microsoft.PowerShell.SDK" Version="7.6.10" />
		<PackageReference Include="AvalonEdit" Version="6.3.1.120" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Views\Yaml.xshd" />
		<EmbeddedResource Include="Views\Yaml.xshd" />
		<Resource Include="Assets\IndexAdvisor.ico" />
	</ItemGroup>

	<ItemGroup>
		<!-- WPF не додає System.IO до неявних using (конфлікт Path із System.Windows.Shapes). -->
		<Using Include="System.IO" />
		<InternalsVisibleTo Include="IndexAdvisor.Gui.Tests" />
	</ItemGroup>

	<!-- Копія модуля поруч з exe: опублікована тека працює без репозиторію (Modules\IndexAdvisor). -->
	<ItemGroup>
		<Content Include="..\IndexAdvisor\**\*" LinkBase="Modules\IndexAdvisor" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
	</ItemGroup>

	<!--
		Один exe (build.ps1 або dotnet publish -r win-x64 -p:PublishSingleFile=true). Без повного розпакування поруч з exe
		лишаються теки Modules (модуль IndexAdvisor) і runtimes (модулі PowerShell SDK), бо це файли, а не збірки.
		Тому exe під час першого запуску розпаковує весь вміст у %TEMP%\.net\<ім'я exe>\<хеш>
		(інше місце — змінна DOTNET_BUNDLE_EXTRACT_BASE_DIR) і працює звідти, як опублікована тека.
	-->
	<PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
		<IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
		<EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
		<!-- NETSDK1244 радить розпакування в пам'ять, але воно лишає модулі поруч з exe. -->
		<MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);NETSDK1244</MSBuildWarningsAsMessages>
	</PropertyGroup>

</Project>
