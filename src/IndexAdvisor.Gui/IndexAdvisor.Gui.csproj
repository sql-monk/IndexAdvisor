<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<RootNamespace>IndexAdvisor.Gui</RootNamespace>
		<AssemblyName>IndexAdvisor.Gui</AssemblyName>
		<Version>0.3.0</Version>
		<Product>IndexAdvisor</Product>
		<Description>Графічна оболонка IndexAdvisor: запуск аналізу, підтвердження дозапитів моделі, перегляд рекомендацій.</Description>
		<!-- ThemeMode (Fluent) у WPF позначено як експериментальний. -->
		<NoWarn>$(NoWarn);WPF0001</NoWarn>
		<!-- Іконка exe (Провідник, панель завдань); вікна беруть її як ресурс. Малює Assets\New-AppIcon.ps1. -->
		<ApplicationIcon>Assets\IndexAdvisor.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<!-- Версія SDK відповідає PowerShell 7.6 (.NET 10). -->
		<PackageReference Include="Microsoft.PowerShell.SDK" Version="7.6.10" />
		<PackageReference Include="AvalonEdit" Version="6.3.1.120" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Views\Yaml.xshd" />
		<EmbeddedResource Include="Views\Yaml.xshd" />
		<Resource Include="Assets\IndexAdvisor.ico" />
	</ItemGroup>

	<ItemGroup>
		<!-- WPF не додає System.IO до неявних using (конфлікт Path із System.Windows.Shapes). -->
		<Using Include="System.IO" />
		<InternalsVisibleTo Include="IndexAdvisor.Gui.Tests" />
	</ItemGroup>

	<!-- Копія модуля в теці програми: Modules\IndexAdvisor (ModuleLocator.BundledPath). -->
	<ItemGroup>
		<Content Include="..\IndexAdvisor\**\*" LinkBase="Modules\IndexAdvisor" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
	</ItemGroup>

	<!-- Розкладка %LOCALAPPDATA%\IndexAdvisor — спільна з лаунчером одиночного exe. -->
	<ItemGroup>
		<Compile Include="..\IndexAdvisor.Launcher\InstallLayout.cs" Link="Infrastructure\InstallLayout.cs" />
	</ItemGroup>

	<!--
		Збірка для розробки (dotnet build/run, тести) працює з живим src\IndexAdvisor свого репозиторію: шлях записується
		в збірку (ModuleLocator.RepositoryPath). Опублікована програма (dotnet publish, build.ps1) його не має й бере лише
		свою копію Modules\IndexAdvisor. Явно: -p:UseRepositoryModule=true|false.
	-->
	<PropertyGroup>
		<UseRepositoryModule Condition="'$(UseRepositoryModule)' == '' and '$(_IsPublishing)' == 'true'">false</UseRepositoryModule>
		<UseRepositoryModule Condition="'$(UseRepositoryModule)' == ''">true</UseRepositoryModule>
	</PropertyGroup>
	<ItemGroup Condition="'$(UseRepositoryModule)' == 'true'">
		<AssemblyMetadata Include="IndexAdvisor.RepositoryModule" Value="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\IndexAdvisor\IndexAdvisor.psd1'))" />
	</ItemGroup>

	<!--
		Одиночний exe — це лаунчер src\IndexAdvisor.Launcher з цією програмою всередині (build.ps1 -Mode SingleFile): він
		розпаковує її в %LOCALAPPDATA%\IndexAdvisor\app\<версія>. Сам GUI одним файлом не публікується: .NET розпакував би
		його в %TEMP%\.net, а без розпакування модулі PowerShell лишаються поруч з exe.
	-->
	<Target Name="RejectSingleFilePublish" BeforeTargets="Build" Condition="'$(PublishSingleFile)' == 'true'">
		<Error Text="IndexAdvisor.Gui не публікується одним файлом. Одиночний exe збирає build.ps1 -Mode SingleFile (лаунчер src\IndexAdvisor.Launcher)." />
	</Target>

</Project>
