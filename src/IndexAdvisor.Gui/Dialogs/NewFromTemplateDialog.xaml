<Window x:Class="IndexAdvisor.Gui.Dialogs.NewFromTemplateDialog"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Нова конфігурація з шаблону"
		Icon="/Assets/IndexAdvisor.ico"
		Width="820"
		Height="600"
		MinWidth="640"
		MinHeight="460"
		WindowStartupLocation="CenterOwner"
		ShowInTaskbar="False">
	<Grid Margin="24,20,24,20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<StackPanel>
			<TextBlock Text="Нова конфігурація з шаблону" FontSize="18" FontWeight="SemiBold" />
			<TextBlock Margin="0,6,0,0" Opacity="0.75" TextWrapping="Wrap"
					   Text="Виберіть шаблон і вкажіть лише сервери та бази. Решта налаштувань береться з шаблону; змінити їх можна у формі налаштувань." />
		</StackPanel>

		<Grid Grid.Row="1" Margin="0,14,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="16" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<DockPanel>
				<TextBlock DockPanel.Dock="Top" Text="Шаблон" FontWeight="SemiBold" Margin="0,0,0,6" />
				<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
					<Button x:Name="OpenFolderButton" Content="Тека шаблонів" Click="OnOpenFolder" />
					<Button x:Name="DeleteButton" Content="Видалити шаблон" Margin="8,0,0,0" Click="OnDelete" />
				</StackPanel>
				<ListBox x:Name="TemplateList" AutomationProperties.Name="Шаблони" MouseDoubleClick="OnCreate">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<StackPanel Margin="0,4">
								<TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
								<TextBlock Text="{Binding Details}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
							</StackPanel>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</DockPanel>

			<StackPanel Grid.Column="2">
				<TextBlock Text="Сервери" FontWeight="SemiBold" Margin="0,0,0,4" />
				<Grid>
					<TextBox x:Name="ServersBox" AutomationProperties.Name="Сервери" TextChanged="OnTextChanged" />
					<TextBlock x:Name="ServersHint" Style="{StaticResource Watermark}" Text="як у шаблоні; кілька — через кому" />
				</Grid>
				<TextBlock Text="Бази" FontWeight="SemiBold" Margin="0,14,0,4" />
				<Grid>
					<TextBox x:Name="DatabasesBox" AutomationProperties.Name="Бази" TextChanged="OnTextChanged" />
					<TextBlock x:Name="DatabasesHint" Style="{StaticResource Watermark}" Text="як у шаблоні; кілька — через кому" />
				</Grid>
				<TextBlock Text="Зберегти у файл" FontWeight="SemiBold" Margin="0,14,0,4" />
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<TextBox x:Name="PathBox" AutomationProperties.Name="Файл конфігурації" TextChanged="OnTextChanged" />
					<TextBlock x:Name="PathHint" Style="{StaticResource Watermark}" Text="не зберігати зараз (запитає перед запуском)" />
					<Button Grid.Column="1" Content="…" Width="40" Margin="6,0,0,0" Click="OnBrowse" />
				</Grid>
				<TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
						   Text="Відносні шляхи в конфігурації (./out, ./archive, ./logs) рахуються від теки, де лежатиме файл." />
			</StackPanel>
		</Grid>

		<TextBlock x:Name="ErrorText" Grid.Row="2" Margin="0,10,0,0" Foreground="{DynamicResource StatusErrorBrush}" TextWrapping="Wrap" Visibility="Collapsed" />

		<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
			<Button x:Name="CreateButton" Content="Створити" MinWidth="120" IsDefault="True" Click="OnCreate" Style="{DynamicResource AccentButtonStyle}" />
			<Button Content="Скасувати" MinWidth="110" IsCancel="True" Margin="8,0,0,0" />
		</StackPanel>
	</Grid>
</Window>
